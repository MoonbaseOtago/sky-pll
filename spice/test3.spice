V0 VGND GND 0
V1 VPWR GND 1.8
#V2 LOCALCLK GND PULSE(0 1.8 1ns 100ps 100ps 10ns 20.1ns)
V3 REFCLK GND PULSE(  0 1.8 1ns 100ps 100ps 10ns 20ns)
#V4 VBIAS GND 0.6

