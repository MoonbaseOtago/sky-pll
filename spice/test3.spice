.tran 0.05n 400000n
.control
save REFCLK LOCALCLK VCTRL UP DOWN VPWR UP_N DOWN_N BU BD  
run
plot v(BD) v(VCTRL) 
eprvcd -a REFCLK LOCALCLK VCTRL UP DOWN VPWR UP_N DOWN_N BU BD  >a.vcd
.endc
.end
